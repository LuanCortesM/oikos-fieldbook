  audios, mapas e listas de especies entrassem. Esses ficam com o backup do app.
-->
<full-backup-content>
    <include domain="database" path="oikos_fieldbook.db" />
    <include domain="database" path="oikos_fieldbook.db-wal" />
    <include domain="sharedpref" path="." />
</full-backup-content>
