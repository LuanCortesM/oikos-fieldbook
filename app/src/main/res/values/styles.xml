<resources>
    <style name="Theme.OikosFieldBook" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FF6A00</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#0B0B0D</item>
    </style>

    <style name="Theme.OikosFieldBook.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0B0D</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.OikosFieldBook</item>
    </style>
</resources>
